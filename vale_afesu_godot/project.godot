; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Vale Afesu 3D"
config/description="Vale Afesu - Jogo de Fazenda 3D Low-Poly com Inteligência Artificial para o curso SENAI / AFESU."
run/main_scene="res://scenes/main_3d.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
TimeManager="*res://scripts/core/time_manager.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

