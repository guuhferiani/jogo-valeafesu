[node name="GuideContent" type="RichTextLabel" parent="GuideModal/Parchment/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.18, 0.1, 0.05, 1)
theme_override_font_sizes/normal_font_size = 12
bbcode_enabled = true
text = "• [b]Movimento 3D:[/b] Teclas W, A, S, D ou Setas (+ Shift para Correr)
• [b]Câmera:[/b] Perspectiva isométrica suave que acompanha o fazendeiro.
• [b]Ferramentas (1 a 6):[/b]
   - [b]1: Enxada[/b] (Ara canteiros férteis em 3D)
   - [b]2: Regador[/b] (Irriga o solo - fica escuro e úmido)
   - [b]3 e 4: Sementes[/b] (Plante Chirívia ou Abóbora)
   - [b]5 e 6: Machado / Picareta[/b] (Limpa canteiros)
• [b]Usar Ferramenta:[/b] Espaço ou Clique Esquerdo do Mouse
• [b]Interagir & Carinho:[/b] Tecla E ou Clique Direito do Mouse
• [b]Animais com IA 3D:[/b] Dê carinho na Galinha Pipoca e na Vaca Mimosa para ver corações 3D pulsando e colher ovos e leite!
• [b]Dormir:[/b] Botão no topo para avançar a noite e colher frutos maduros."

